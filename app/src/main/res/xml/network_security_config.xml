<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <!--
        Optional certificate pinning (documented in README, not enabled by default):
        add a <pin-set expiration="..."> with a backup pin inside a
        <domain-config> for your server host here at build time.
        -->
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
